{
	"name": "pipeline-databricks-param",
	"properties": {
		"activities": [
			{
				"name": "Notebook-Process-Emp",
				"description": "Notebook-Process-Emp",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/shehzad.merchant@lanternstudios.com/Notebooks/Run_Wite_Emp_Data",
					"baseParameters": {
						"parent_dept": "Sales"
					}
				},
				"linkedServiceName": {
					"referenceName": "adb_shehzadmerchant_003",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks Execution",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Notebook-Process-Emp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Notebook-Process-Emp').output.RunOutput.status,'SUCCESS')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Failed Activity",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@activity('Notebook-Process-Emp').output.runOutput.error",
									"type": "Expression"
								},
								"errorCode": "500"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Set RecordCount",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_RecordCount",
								"value": {
									"value": "@activity('Notebook-Process-Emp').output.runOutput.rows_count",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"v_RecordCount": {
				"type": "String"
			}
		},
		"annotations": []
	}
}