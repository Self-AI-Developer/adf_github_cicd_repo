{
	"name": "pipeline-refresh-semanticmodel",
	"properties": {
		"activities": [
			{
				"name": "Fabric - Refresh Semantic Model-1",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@concat('https://api.powerbi.com/v1.0/myorg/groups/',pipeline().parameters.WorkSpaceID,'/datasets/',pipeline().parameters.SemanticModelID,'/refreshes')",
						"type": "Expression"
					},
					"body": {
						"status": "success",
						"message": "Data retrieved successfully",
						"id": 101,
						"active": true
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://analysis.windows.net/powerbi/api"
					}
				}
			}
		],
		"parameters": {
			"WorkSpaceID": {
				"type": "string",
				"defaultValue": "b7d13003-23f1-4848-9bcf-e5c76e8b1868"
			},
			"SemanticModelID": {
				"type": "string",
				"defaultValue": "09dcceba-173a-45f4-a6bf-5a157d630f3e"
			}
		},
		"annotations": []
	}
}